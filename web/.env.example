# Name shown in the header and browser tab.
VITE_APP_NAME=Fleet Tracker
# Map tiles. The default OpenStreetMap servers are for light use only:
# for production use a provider such as MapTiler, Stadia Maps or Thunderforest.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
