{
  "name": "gpstracker-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the GPS tracking platform: vendor push receiver and vendor API client",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-admin": "tsx --env-file-if-exists=.env src/cli/createAdmin.ts",
    "seed-demo": "tsx --env-file-if-exists=.env src/cli/seedDemo.ts",
    "simulate": "tsx --env-file-if-exists=.env src/cli/simulate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
