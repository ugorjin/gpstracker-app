# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://gpstracker:gpstracker@localhost:5432/gpstracker

# --- Vendor platform API -------------------------------------------------
# Ask your hardware vendor for the API domain ("api.yourdomain.com" in their docs).
VENDOR_API_BASE_URL=https://api.your-vendor-domain.com
VENDOR_API_PATH=/openapi
VENDOR_USERNAME=your-platform-account
VENDOR_PASSWORD=your-platform-password
# Timezone offset (hours) for report dates. Nigeria (WAT) = 1.
VENDOR_TIMEZONE=1
VENDOR_COMMAND_PASSWORD=zhuyi
# Vendor limit is 10/minute per IP; keep headroom.
VENDOR_RATE_PER_MINUTE=8
# 1440 + 5 x number of paid devices.
VENDOR_DAILY_BUDGET=1440

# --- Push receiver -------------------------------------------------------
# In the vendor platform: Forwarding settings -> protocol "Http Sign Json",
#   URL      = https://<your-host>/push/vendor
#   Account  = PUSH_APP_ID
#   Password = PUSH_APP_SECRET
# Generate a secret with:  openssl rand -hex 24
PUSH_APP_ID=gpstracker
PUSH_APP_SECRET=change-me
PUSH_ALLOW_UNSIGNED=false
PUSH_TIMESTAMP_TOLERANCE_MS=300000
PUSH_STORE_RAW=true

# --- Dashboard API -------------------------------------------------------
# Browser origins of the web dashboard (comma-separated).
CORS_ORIGINS=http://localhost:5173
# Country assumed for phone numbers typed without +country code.
DEFAULT_COUNTRY=NG
SESSION_TTL_DAYS=30
# No data for this long = device shown as offline.
OFFLINE_AFTER_MINUTES=30
